---
import ThemeSwitch from './ThemeSwitch.astro';
import { getDict, homePath, otherLang, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang).nav;
const other = otherLang(lang);
const links = [
  ['#about', t.about],
  ['#work', t.work],
  ['#experience', t.experience],
  ['#contact', t.contact],
] as const;
---
<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Main">
    <a href={homePath(lang)} class="font-serif text-2xl leading-none tracking-tight">
      Wisnhu<span class="text-accent">.</span>
    </a>
    <div class="flex items-center gap-5 sm:gap-7">
      <ul class="hidden items-center gap-7 text-[15px] text-muted md:flex">
        {links.map(([href, label]) => (
          <li><a href={href} class="transition-colors hover:text-fg">{label}</a></li>
        ))}
      </ul>
      <a
        href={homePath(other)}
        hreflang={other}
        aria-label={t.langLabel}
        title={t.langLabel}
        class="font-mono text-xs tracking-wider text-muted transition-colors hover:text-fg"
      >
        <span class={lang === 'en' ? 'text-fg' : ''}>EN</span>
        <span class="mx-1 text-line">/</span>
        <span class={lang === 'id' ? 'text-fg' : ''}>ID</span>
      </a>
      <ThemeSwitch label={t.themeLabel} />
    </div>
  </nav>
</header>
