---
import Section from './Section.astro';
import { getDict, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang).experience;
---
<Section id="experience" index="03" label={t.label} title={t.title}>
  <ol class="space-y-12">
    {t.jobs.map((job) => (
      <li class="grid gap-2 sm:grid-cols-[170px_1fr] sm:gap-8">
        <p class="font-mono text-sm text-muted sm:pt-1">{job.period}</p>
        <div>
          <h3 class="text-xl font-medium">{job.role}</h3>
          <p class="text-muted">{job.company} · {job.place}</p>
          <ul class="mt-4 space-y-2 text-[16px]">
            {job.points.map((p) => (
              <li class="relative pl-5 before:absolute before:left-0 before:text-muted before:content-['–']">{p}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
    <li class="grid gap-2 border-t border-line pt-10 sm:grid-cols-[170px_1fr] sm:gap-8">
      <p class="font-mono text-sm text-muted sm:pt-1">{t.education.period}</p>
      <div>
        <p class="label mb-2">{t.education.label}</p>
        <h3 class="text-xl font-medium">{t.education.degree}</h3>
        <p class="text-muted">{t.education.school}</p>
      </div>
    </li>
  </ol>
</Section>
